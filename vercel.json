{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/invoice/:token", "destination": "/invoice.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/invoice/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
