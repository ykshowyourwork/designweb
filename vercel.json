{
  "cleanUrls": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.desiweb.org" }], "destination": "https://desiweb.org/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/invoice/:token", "destination": "/invoice" }
  ],
  "headers": [
    { "source": "/invoice/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
